                checked={signupForm.ageVerified}
                onChange={(e) => setSignupForm({...signupForm, ageVerified: e.target.checked})}
                className="mt-1 rounded border-gray-300 text-pink-600 focus:ring-pink-500"
                required
              />
              <label htmlFor="age" className="ml-2 text-sm text-gray-700 flex items-center">
                <Shield className="w-4 h-4 mr-1 text-red-500" />
                Je certifie avoir au moins 18 ans et être majeur(e) dans mon pays de résidence
              </label>
            </div>
            {errors.age && <p className="text-red-500 text-xs">{errors.age}</p>}
          </div>

          <button
            type="submit"
            disabled={loading}
            className="w-full bg-gradient-to-r from-pink-500 to-purple-600 text-white font-bold py-3 px-4 rounded-xl hover:scale-[1.02] transform transition-all duration-300 disabled:opacity-50 disabled:cursor-not-allowed flex items-center justify-center"
          >
            {loading ? (
              <>
                <div className="animate-spin rounded-full h-5 w-5 border-b-2 border-white mr-2"></div>
                Création en cours...
              </>
            ) : (
              <>
                <CheckCircle className="w-5 h-5 mr-2" />
                Créer mon Compte
              </>
            )}
          </button>
        </form>

        <div className="mt-6 text-center">
          <button 
            onClick={() => setCurrentView('login')}
            className="text-pink-600 hover:text-pink-800 font-medium"
          >
            Déjà un compte ? Connectez-vous
          </button>
        </div>

        <button 
          onClick={() => setCurrentView('landing')}
          className="mt-4 w-full text-gray-600 hover:text-gray-800"
        >
          ← Retour à l'accueil
        </button>

        {/* Informations de sécurité */}
        <div className="mt-8 bg-green-50 border border-green-200 rounded-lg p-4">
          <div className="flex items-center mb-2">
            <Shield className="w-5 h-5 text-green-600 mr-2" />
            <h4 className="font-semibold text-green-800">Sécurité et Confidentialité</h4>
          </div>
          <ul className="text-xs text-green-700 space-y-1">
            <li>• Chiffrement AES-256 de toutes vos données</li>
            <li>• Vérification d'identité par SMS et email</li>
            <li>• Modération automatique et humaine des profils</li>
            <li>• Signalement et blocage instantané</li>
            <li>• Conformité RGPD et protection des données</li>
            <li>• Authentification à deux facteurs disponible</li>
          </ul>
        </div>
      </div>
    </div>
  );

  // Rendu conditionnel basé sur la vue actuelle
  const renderCurrentView = () => {
    switch(currentView) {
      case 'login':
        return <LoginPage />;
      case 'signup':
        return <SignupPage />;
      default:
        return <LandingPage />;
    }
  };

  return (
    <div className="relative">
      {/* Overlay de chargement global */}
      {loading && (
        <div className="fixed inset-0 bg-black/50 backdrop-blur-sm z-50 flex items-center justify-center">
          <div className="bg-white rounded-2xl p-8 text-center">
            <div className="animate-spin rounded-full h-12 w-12 border-b-2 border-pink-500 mx-auto mb-4"></div>
            <p className="text-lg font-semibold text-gray-800">
              {currentView === 'signup' ? 'Création de votre compte...' : 'Connexion en cours...'}
            </p>
            <p className="text-sm text-gray-600 mt-2">Vérification sécurisée</p>
          </div>
        </div>
      )}

      {/* Notifications de sécurité (simulation) */}
      <div className="fixed top-4 right-4 z-40 space-y-2">
        {/* Ces notifications apparaîtraient en fonction des actions utilisateur */}
      </div>

      {renderCurrentView()}
    </div>
  );
};

export default PokemonDatingAuth;