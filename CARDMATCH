                <div className={`w-2 h-2 rounded-full mr-2 ${securityChecks.uppercase ? 'bg-green-500' : 'bg-red-500'}`}></div>
                <span className={securityChecks.uppercase ? 'text-green-600' : 'text-red-600'}>Une majuscule</span>
