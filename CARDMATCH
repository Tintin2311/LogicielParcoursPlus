              </div>
              <div className="flex items-center text-xs">
                <div className={`w-2 h-2 rounded-full mr-2 ${securityChecks.number ? 'bg-green-500' : 'bg-red-500'}`}></div>
                <span className={securityChecks.number ? 'text-green-600' : 'text-red-600'}>Un chiffre</span>
              </div>
              <div className="flex items-center text-xs">
                <div className={`w-2 h-2 rounded-full mr-2 ${securityChecks.special ? 'bg-green-500' : 'bg-red-500'}`}></div>
